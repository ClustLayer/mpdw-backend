# ==============================================================================
# Variables de Entorno - Plantilla de Configuración (.env.example)
# SAD Ref: ADR-003, ADR-006, ADR-011, ADR-012, §13.4, Regla R6
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración Básica de Django
# ------------------------------------------------------------------------------
# Clave secreta criptográfica de Django (generar una aleatoria en producción)
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-aleatoria-en-produccion-50-caracteres

# Módulo de configuración activo (config.settings.development | production | testing)
DJANGO_SETTINGS_MODULE=config.settings.development

# Modo depuración (True en local, estricto False en producción)
DEBUG=True

# Puerto HTTP del servidor WSGI
PORT=8000

# Concurrencia de workers síncronos de Gunicorn
WEB_CONCURRENCY=2

# Hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,api.mundopinturasdiana.com,api.staging.mundopinturasdiana.com

# Orígenes CORS autorizados para la SPA en Vercel
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://mundopinturasdiana.com,https://www.mundopinturasdiana.com,https://staging.mundopinturasdiana.com

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL / Supabase
# ------------------------------------------------------------------------------
# Desarrollo en Supabase nube: use el pooler del panel (usuario postgres.<project-ref>).
# API/transacciones: puerto 6543. Migraciones: Session mode puerto 5432 en el mismo host pooler.
# Ejemplo: postgresql://postgres.<ref>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Conexión operacional (API): pooler transacción (6543) o Docker local con rol mpdw_app
DATABASE_URL=postgresql://mpdw_app:app_secret_123@db:5432/mpdw_db

# Conexión de migraciones: conexión directa de sesión (puerto 5432 en Supabase) con rol mpdw_migrate
DATABASE_MIGRATE_URL=postgresql://mpdw_migrate:migrate_secret_123@db:5432/mpdw_db

# Conexión ETL: conexión directa de sesión con rol mpdw_etl
DATABASE_ETL_URL=postgresql://mpdw_etl:etl_secret_123@db:5432/mpdw_db

# Conexión BI / Analítica: lectura de solo lectura con rol mpdw_bi sobre esquema analitica
DATABASE_BI_URL=postgresql://mpdw_bi:bi_secret_123@db:5432/mpdw_db

# Variables para contenedor Docker PostgreSQL local (docker-compose)
POSTGRES_DB=mpdw_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
MPDW_APP_PASSWORD=app_secret_123
MPDW_ETL_PASSWORD=etl_secret_123
MPDW_MIGRATE_PASSWORD=migrate_secret_123
MPDW_BI_PASSWORD=bi_secret_123

# ------------------------------------------------------------------------------
# Seguridad y Autenticación JWT / Cookies
# ------------------------------------------------------------------------------
# Clave HMAC/RSA para firma de access tokens JWT
JWT_SIGNING_KEY=clave-secreta-para-firmar-jwt-access-tokens-minimo-32-bytes

# Identificador de la clave activa para soportar rotación (kid)
JWT_KEY_ID=k1

# Tiempo de vida del access token en minutos (SAD AD-11: 15 min)
ACCESS_TOKEN_LIFETIME_MINUTES=15

# Tiempo de vida absoluto del refresh token en días (SAD AD-11: 7 días)
REFRESH_TOKEN_LIFETIME_DAYS=7

# Ventana de inactividad deslizante del refresh token en minutos (HU 05: 60 min)
INACTIVITY_TIMEOUT_MINUTES=60

# Minutos de aviso antes de la expiracion por inactividad (HU 05: 5 min)
SESSION_WARNING_MINUTES=5

# Intentos fallidos antes del bloqueo y duracion del bloqueo (HU 01)
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# Vigencia del enlace de recuperacion, en minutos (HU 03)
RECUPERACION_MINUTOS=60

# Segundo factor (HU 06)
CODIGO_2FA_MINUTOS=10
MAX_INTENTOS_2FA=3

# Origen publico del frontend, usado solo para armar el enlace de recuperacion
FRONTEND_URL=http://localhost:5173

# Dominio para la cookie SameSite=Strict de refresh token (.mundopinturasdiana.com en prod)
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# Proveedores Externos (SendGrid & Supabase Storage)
# ------------------------------------------------------------------------------
# API Key de SendGrid para recuperación de contraseña y 2FA.
# Si queda vacia, el backend usa el relay SMTP definido mas abajo.
SENDGRID_API_KEY=

# Relay SMTP (por ejemplo Brevo). No versionar la contrasena real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@mundopinturasdiana.com
SMTP_FROM_NAME=Mundo Pinturas Diana
SMTP_USE_TLS=true

# Remitente verificado del dominio institucional
DEFAULT_FROM_EMAIL=no-reply@mundopinturasdiana.com

# URL base del servicio de Supabase Storage
SUPABASE_STORAGE_URL=https://placeholder-project.supabase.co/storage/v1

# Clave de servicio de Supabase (nunca sale del backend)
SUPABASE_STORAGE_SERVICE_KEY=placeholder-supabase-service-role-key

# Buckets de almacenamiento
SUPABASE_PUBLIC_BUCKET=medios-publicos
SUPABASE_PRIVATE_BUCKET=adjuntos-privados

# Límite máximo de subida de archivos en bytes (5 MB = 5242880)
MAX_FILE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# Semilla Inicial: Primer Administrador (SAD BR-09, D6)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@mundopinturasdiana.com
INITIAL_ADMIN_PASSWORD=PLACEHOLDER_INSECURE_CAMBIAR_EN_PRODUCCION
INITIAL_ADMIN_NAME="Administrador Inicial MPDW"

# ------------------------------------------------------------------------------
# Desarrollo contra Supabase en nube (manual): use DATABASE_URL directo puerto 5432.
# Docker local sigue disponible con los roles mpdw_* de este archivo.
# Pruebas automatizadas: copie .env.test.example a .env.test (sin URL de nube).
# ------------------------------------------------------------------------------

# Usuarios de demostración (comando seed_epic1_demo_users; no versionar contraseñas reales)
DEMO_ADMIN_EMAIL=admin.demo@mundopinturasdiana.com
DEMO_ADMIN_PASSWORD=PLACEHOLDER_DEMO_PASSWORD
DEMO_GERENTE_EMAIL=gerente.demo@mundopinturasdiana.com
DEMO_GERENTE_PASSWORD=PLACEHOLDER_DEMO_PASSWORD
DEMO_EMPLEADO_EMAIL=empleado.demo@mundopinturasdiana.com
DEMO_EMPLEADO_PASSWORD=PLACEHOLDER_DEMO_PASSWORD

