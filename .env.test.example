# Plantilla para pruebas automatizadas (copiar a .env.test si hace falta).
# No apunte a Supabase en nube: pytest local usa SQLite en memoria salvo MPDW_TEST_USE_POSTGRES.

DJANGO_SETTINGS_MODULE=config.settings.testing
DJANGO_SECRET_KEY=test-secret-key-for-local-pytest-only-32-chars
JWT_SIGNING_KEY=test-jwt-signing-key-for-local-pytest-only-32b

# Dejar vacío para forzar SQLite en config.settings.testing
DATABASE_URL=
DATABASE_MIGRATE_URL=
DATABASE_BI_URL=
